---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";

/**
 * Cloudflare Pages looks for a 404.html at the root of the build output and
 * serves it, with a 404 status, for every path that matches no file. Without
 * this page it answers those paths with the home page and a 200 instead, which
 * would put an unbounded set of soft duplicates in front of a crawler.
 */
---

<Base
  title="Not found"
  description={`This page does not exist. ${SITE.description}`}
>
  <div
    class="mx-auto flex min-h-screen w-full max-w-[1160px] flex-col px-6 sm:px-10"
  >
    <header class="pt-20 sm:pt-28">
      <a href="/" class="wordmark inline-block text-bone">The Design Index</a>
    </header>

    <main class="flex flex-1 flex-col justify-center py-24">
      <p class="label tabular-nums text-grey">404</p>
      <h1 class="mt-6 max-w-[24ch] text-title font-normal text-bone">
        Nothing is filed here.
      </h1>
      <p class="mt-5 max-w-[52ch] text-body text-grey">
        The page you asked for does not exist. It may have been renamed, or the
        link that brought you here may have been wrong from the start.
      </p>
      <p class="mt-10">
        <a
          href="/"
          class="label inline-flex h-11 items-center border border-grey/50 px-6 text-bone transition-colors hover:border-bone"
        >
          Back to the index
        </a>
      </p>
    </main>

    <footer class="pb-24">
      <hr class="border-0 border-t border-grey/25" />
      <p class="mt-8 text-small text-grey">
        Free to use, no attribution needed.
      </p>
    </footer>
  </div>
</Base>
